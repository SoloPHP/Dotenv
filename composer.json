{
  "name": "solophp/dotenv",
  "type": "library",
  "description": "Read layered .env files as an array or load them into the PHP environment.",
  "keywords": ["dotenv", "environment", "configuration", "php"],
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Solo\\Dotenv\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\Dotenv\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text",
    "analyse": "phpstan analyse --no-progress",
    "cs": "phpcs",
    "cs-fix": "phpcbf",
    "check": [
      "@composer validate --strict",
      "@test",
      "@analyse",
      "@cs"
    ]
  }
}
